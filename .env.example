# A2A Settlement Mediator — Environment Configuration
# Copy to .env and fill in your values.

# --- Exchange connection ---
A2A_EXCHANGE_URL=http://127.0.0.1:3000/v1
A2A_OPERATOR_API_KEY=ate_your_operator_api_key_here

# --- LLM provider (via LiteLLM) ---
# Supports: anthropic/claude-sonnet-5-5, openai/gpt-4o, etc.
# See: https://docs.litellm.ai/docs/providers
MEDIATOR_LLM_MODEL=anthropic/claude-sonnet-5-5
# "none" (the default) sends no temperature; Claude 5.x models reject one.
# For a model that accepts it, set a number, e.g. MEDIATOR_LLM_TEMPERATURE=0.1
MEDIATOR_LLM_TEMPERATURE=none
MEDIATOR_LLM_MAX_TOKENS=4096

# LLM provider API keys (set the one matching your model)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Mediation policy ---
# Confidence threshold (0.0–1.0). Below this → escalate to human.
MEDIATOR_AUTO_RESOLVE_THRESHOLD=0.80
# Max seconds to wait for LLM response.
MEDIATOR_LLM_TIMEOUT=30
# Log full LLM prompts and responses.
MEDIATOR_AUDIT_LOG=true

# --- Webhook listener ---
MEDIATOR_HOST=127.0.0.1
MEDIATOR_PORT=3100
# Secret from exchange webhook registration; keys /webhook. It also keys every
# purpose below that has no secret of its own. While a purpose has no secret at
# all, its routes answer 503.
MEDIATOR_WEBHOOK_SECRET=
# Optional per-purpose secrets. Leave one empty and that purpose uses
# MEDIATOR_WEBHOOK_SECRET. Set one and only it is accepted for that purpose.
# Use a different random value for each (e.g. `openssl rand -hex 32`); the caller
# must sign with the same value. See SECURITY.md for the rollout order.
# Operator routes: /mediate, /audits, /settle, /settlements, /merkle, /heartbeat/status.
MEDIATOR_OPERATOR_SECRET=
# POST /api/v1/verify-patch.
MEDIATOR_VERIFY_PATCH_SECRET=
# POST /api/v1/receipts.
MEDIATOR_RECEIPTS_SECRET=
# Rollout aid. true makes a purpose that has its own secret also accept
# MEDIATOR_WEBHOOK_SECRET, so callers can be switched without a failed request.
# Set it back to false as soon as every caller signs with its own secret.
MEDIATOR_SECRET_TRANSITION_ACCEPT_FALLBACK=false
# Max seconds of clock skew accepted on signed requests.
MEDIATOR_SIGNATURE_TOLERANCE_S=300
# LOCAL DEVELOPMENT ONLY. With no secret set, true makes /webhook and the operator
# routes accept unsigned requests. Ignored for /webhook when MEDIATOR_WEBHOOK_SECRET
# is set, and for the operator routes when that or MEDIATOR_OPERATOR_SECRET is set.
MEDIATOR_INSECURE_ALLOW_UNAUTHENTICATED=false
# Public base URL advertised in /health guide_url, e.g. https://exchange.example.org/mediator
MEDIATOR_PUBLIC_URL=

# --- Escalation ---
# Slack incoming webhook URL for low-confidence escalation notices.
MEDIATOR_ESCALATION_WEBHOOK_URL=

# --- SEC 17a-4 WORM Settlement Pipeline ---
# RFC 3161 Time Stamp Authority URL.
MEDIATOR_TSA_URL=http://freetsa.org/tsr
# Max seconds to wait for TSA response before hard-failing the settlement.
MEDIATOR_TSA_TIMEOUT=15

# --- Provenance fetches ---
# LOCAL DEVELOPMENT AND TESTS ONLY. Provenance source URLs are written by escrow
# parties. By default the mediator refuses to fetch any that resolve to a loopback,
# private, link-local or otherwise non-public address. true lifts that check.
MEDIATOR_INSECURE_ALLOW_PRIVATE_FETCH_ADDRESSES=false
